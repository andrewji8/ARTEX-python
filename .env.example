# ARTEX-python Deployment Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://artex_user:artex_pass@postgres:5432/artex_db
DB_ECHO=false

# App
APP_NAME=ARTEX Python
DEBUG=false

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret

# Auto-updater (supervisor.py)
GITHUB_REPO=your-org/artex-python
GITHUB_TOKEN=
UPDATE_CHECK_INTERVAL=300
DRAIN_TIMEOUT=120
DOCKER_IMAGE=artex-python:latest
CONTAINER_NAME=artex-backend

# Docker Compose overrides
DB_USER=artex_user
DB_PASS=artex_pass
DB_NAME=artex_db
