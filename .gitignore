# ==============================================================================
# ARTEX-python .gitignore
# ==============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Local config / secrets (NEVER commit real credentials) ---
.env
.env.local
*.log
pip_err.txt

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- Local dev artifacts ---
uvicorn.log*
web.log*

# --- Docker named volumes / local data ---
data/
pgdata/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# --- Keep these tracked (explicit) ---
!.env.example

# --- 调试过程报告（本地保留，不上传）---
EXECUTION_REPORT.md
PHASE2_FIX_REPORT.md
PHASE2_REPORT.md
PHASE3_REPORT.md
PHASE4_REPORT.md
DEPLOYMENT_REPORT.md
TESTING_REPORT.md

RUNNING_GUIDE.md
